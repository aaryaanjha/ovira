# ---- Supabase (required in production) ----
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
# Supabase -> Project Settings -> API: Project URL and the service_role secret key (server-only, never expose it).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for admin image uploads (created by supabase/setup.sql)
SUPABASE_STORAGE_BUCKET=ovira-media

# ---- Admin panel login (required) ----
# Generate the hash and secret with: npm run admin:password -- "your password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ---- Site ----
# Public application URL without a trailing slash in production
APP_ORIGIN=https://www.ovirascience.com
# Optional: set only when a trusted proxy overwrites this header
TRUSTED_CLIENT_IP_HEADER=

# ---- Local development only ----
# Without DATABASE_URL the app uses a local SQLite file (defaults to .data/ovira.sqlite)
OVIRA_DB_PATH=.data/ovira.sqlite

# Optional Google Sheets backend for appointment and lead records
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Set to google-sheets to prefer Sheets when a database is also configured
OVIRA_APPOINTMENT_STORAGE=
