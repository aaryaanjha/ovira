# Required for staff sign-in; keep the password hash and session secret private.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Public application URL without a trailing slash in production
APP_ORIGIN=https://www.ovirascience.com
# Optional: set only when a trusted proxy overwrites this header
TRUSTED_CLIENT_IP_HEADER=
# SQLite content database (defaults to .data/ovira.sqlite)
OVIRA_DB_PATH=.data/ovira.sqlite
# Required on Vercel for persistent content and form submissions
DATABASE_URL=
# Set by the Vercel Blob integration for production image uploads
BLOB_READ_WRITE_TOKEN=
